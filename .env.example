# 部署平台的环境变量（全部可选）
# ─────────────────────────────────────────────
# 站点地址：留空时自动识别（Vercel / Cloudflare Pages / Render / Netlify /
# Railway 等平台的域名变量已内置支持）。自定义域名或特殊平台时显式指定，
# 让 canonical / sitemap / 分享卡指向正确域名：
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# 微信 JS-SDK 分享适配（可选）：配置后微信内分享卡片将精确可控。
# 需要一个公众号（订阅号即可），并在公众号后台
# 「设置与开发 → 公众号设置 → 功能设置 → JS 接口安全域名」填入站点域名。
# 不配置时站点自动降级为微信默认抓取，不影响正常访问。
WECHAT_APPID=wx0000000000000000
WECHAT_APPSECRET=your-app-secret-here

# 站长平台验证（可选，配置后自动注入对应 meta 标签）
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
