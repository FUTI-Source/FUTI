# 139 邮箱 SMTP 凭证（复制为 .env.local 后填写真实值，切勿提交真实授权码）
# 发件邮箱地址（同时作为 SMTP 登录账号）
MAIL_USER=your_mailbox@139.com
# 139 邮箱 SMTP 授权码（不是邮箱登录密码）
MAIL_PASS=your_smtp_authorization_code
# 站长收信地址，留空时默认发给 MAIL_USER
MAIL_TO=mine@139.com
# 以下为可选默认值，通常无需修改
MAIL_SMTP_HOST=smtp.139.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true

# Bark 推送：收到新留言或打赏时推送到 iPhone（可选，留空则不推送）
# 在 Bark App 中复制的设备 key
BARK_DEVICE_KEY=
# 自建 Bark 服务端地址，留空使用官方 https://api.day.app
BARK_SERVER_URL=

# 打赏支付：微信 + 支付宝（密钥只放服务端，切勿提交真实值）
# 微信支付 APIv3
WECHAT_MCH_ID=
WECHAT_APP_ID=
# 32 位 APIv3 密钥
WECHAT_API_V3_KEY=
# 商户 API 证书序列号
WECHAT_CERT_SERIAL_NO=
# apiclient_key.pem 内容，换行可写成 \n
WECHAT_PRIVATE_KEY=
# 微信支付公钥模式：公钥 ID 与公钥内容（用于回调验签）
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY=
# 公众号 AppSecret，用于微信内网页授权与 JSAPI 支付
WECHAT_APP_SECRET=
# 可选：自定义回调地址，默认按 SITE_URL 拼接
WECHAT_NOTIFY_URL=
# 支付宝开放平台（RSA2）
ALIPAY_APP_ID=
# 应用私钥，换行可写成 \n
ALIPAY_PRIVATE_KEY=
# 支付宝公钥，用于回调验签
ALIPAY_PUBLIC_KEY=
# 可选：网关与回调地址
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
# 无状态订单签名密钥：随机 32 位以上字符串，用于签发和校验查单令牌
DONATION_ORDER_SECRET=
