# 主通知 Webhook：联系表单与打赏通知都会 POST JSON 到这个地址
# 必填：任意支持 HTTP POST 的地址（自建服务、n8n、Make、Zapier，或飞书 / 钉钉 / 企微群机器人）
NOTIFY_WEBHOOK_URL=https://example.com/webhook
# 可选：主 Webhook 失败时，把失败事件（含原始 payload 与错误原因）POST 到这里
NOTIFY_WEBHOOK_FALLBACK_URL=
# 可选：设置后会以 Authorization: Bearer <secret> 发送
NOTIFY_WEBHOOK_SECRET=
# 可选：失败 Webhook 使用独立令牌；留空则复用 NOTIFY_WEBHOOK_SECRET
NOTIFY_WEBHOOK_FALLBACK_SECRET=

# 打赏支付：微信 + 支付宝（密钥只放服务端，切勿提交真实值）
# 微信支付 APIv3
WECHAT_MCH_ID=
WECHAT_APP_ID=
# 32 位 APIv3 密钥
WECHAT_API_V3_KEY=
# 商户 API 证书序列号
WECHAT_CERT_SERIAL_NO=
# apiclient_key.pem 内容，换行可写成 \n
WECHAT_PRIVATE_KEY=
# 微信支付公钥模式：公钥 ID 与公钥内容（用于回调验签）
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY=
# 公众号 AppSecret，用于微信内网页授权与 JSAPI 支付
WECHAT_APP_SECRET=
# 可选：自定义回调地址，默认按 SITE_URL 拼接
WECHAT_NOTIFY_URL=
# 支付宝开放平台（RSA2）
ALIPAY_APP_ID=
# 应用私钥，换行可写成 \n
ALIPAY_PRIVATE_KEY=
# 支付宝公钥，用于回调验签
ALIPAY_PUBLIC_KEY=
# 可选：网关与回调地址
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
# 可选：商户收款账号（sellerId，一般是商户邮箱）。填写后回调会校验卖家账号，
# 能挡住「拿别人商户的异步通知冒充本站订单」这类跨商户通知
ALIPAY_SELLER_ID=
# PayPal（面向境外访客的第三渠道）：仅配置 CLIENT_ID 与 CLIENT_SECRET 后启用
# PAYPAL_ENV 不填默认 sandbox（测试），上线填 live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# PayPal 开发者后台创建的 Webhook ID；不配置则 /api/donate/webhook/paypal 拒绝所有回调
PAYPAL_WEBHOOK_ID=
# 无状态订单签名密钥（可选）：随机 32 位以上字符串，用于签发和校验查单令牌
# 留空时自动从支付凭据（WECHAT_PRIVATE_KEY / ALIPAY_PRIVATE_KEY / PAYPAL_CLIENT_SECRET）派生，无需手动生成
DONATION_ORDER_SECRET=

# ── 站点配置不在这里 ────────────────────────────────────────────────
# 域名、文案、备案、打赏档位、统计与 CDN 缓存等公开配置，
# 统一在仓库根目录 site.config.ts 里改（带逐项注释），改完重新部署即可。
# 单域名分流是 DNS 控制台配置，不在代码或环境变量里。
# 本文件只放「不能进 Git」的东西：密钥、令牌、私钥。
# 部署侧凭据（VERCEL_TOKEN / IGA_ACCESS_KEY / IGA_SECRET_KEY / IGA_PROJECT）
# 不写进本文件：它们只在发布时用一次，存在本机环境变量或密码管理器里；
# 运行时用到的密钥（NOTIFY_* / WECHAT_* / ALIPAY_*）分别配在 Vercel 与 IGA
# 的项目环境变量里，见 README「部署到 Vercel」与「部署到 IGA Pages」。

# 本地/预览环境的 dev 来源白名单（可选，逗号分隔），供 next.config.ts 的 allowedDevOrigins 使用
# NEXT_ALLOWED_DEV_ORIGINS=
