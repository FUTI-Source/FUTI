# 139 邮箱 SMTP 凭证（复制为 .env.local 后填写真实值，切勿提交真实授权码）
# 发件邮箱地址（同时作为 SMTP 登录账号）
MAIL_USER=your_mailbox@139.com
# 139 邮箱 SMTP 授权码（不是邮箱登录密码）
MAIL_PASS=your_smtp_authorization_code
# 站长收信地址，留空时默认发给 MAIL_USER
MAIL_TO=mine@139.com
# 以下为可选默认值，通常无需修改
MAIL_SMTP_HOST=smtp.139.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true

# 打赏支付渠道（未填写的渠道会在打赏弹窗里显示“未配置”）
# 密钥只放在服务端环境变量中，切勿提交真实值
# 支付宝当面付（待接入）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 微信支付 Native（已实现下单、查单与回调）
WECHAT_MCH_ID=
WECHAT_APP_ID=
# 公众号 AppSecret，用于微信内 JSAPI 支付获取 openid（不填则微信内退化为扫码）
WECHAT_APP_SECRET=
# 32 位 APIv3 密钥
WECHAT_API_V3_KEY=
# 商户 API 证书序列号
WECHAT_CERT_SERIAL_NO=
# apiclient_key.pem 内容，换行可写成 \n
WECHAT_PRIVATE_KEY=
# 微信支付公钥模式：公钥 ID 与公钥内容（用于回调验签）
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY=
# 可选：自定义回调地址，默认按请求来源拼成 /api/donate/notify/wechat
WECHAT_NOTIFY_URL=
# 微信内 JSAPI 支付需在公众号后台配置「网页授权域名」，
# 并在商户平台配置「JSAPI 支付授权目录」，域名需与站点一致
# 生产环境必须配置 Upstash Redis 以持久化订单（本地未配置时退化为进程内存）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Apple Pay（需 Apple 开发者商户号，并在支付服务商完成域名校验）
APPLE_PAY_MERCHANT_ID=
APPLE_PAY_MERCHANT_VALIDATION_URL=
