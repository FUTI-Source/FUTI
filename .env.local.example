# 139 邮箱 SMTP 凭证（复制为 .env.local 后填写真实值，切勿提交真实授权码）
# 发件邮箱地址（同时作为 SMTP 登录账号）
MAIL_USER=your_mailbox@139.com
# 139 邮箱 SMTP 授权码（不是邮箱登录密码）
MAIL_PASS=your_smtp_authorization_code
# 站长收信地址，留空时默认发给 MAIL_USER
MAIL_TO=mine@139.com
# 以下为可选默认值，通常无需修改
MAIL_SMTP_HOST=smtp.139.com
MAIL_SMTP_PORT=465
MAIL_SMTP_SECURE=true

# 打赏支付渠道（Apple Pay / Google Pay 均通过 Stripe 收款）
# 密钥只放在服务端环境变量中，切勿提交真实值
STRIPE_SECRET_KEY=
# 可选：结算币种，默认 cny
STRIPE_CURRENCY=
# Apple Pay：在 Stripe Dashboard 的 Payment methods 中注册站点域名
# Google Pay：在 Stripe Dashboard 启用钱包，并通过 HTTPS 访问站点
