# 通知 Webhook：联系表单与打赏通知都会 POST JSON 到这个地址
# 必填：任意支持 HTTP POST 的地址（自建服务、n8n、Make、Zapier 等）
NOTIFY_WEBHOOK_URL=https://example.com/webhook
# 可选：设置后会以 Authorization: Bearer <secret> 发送
NOTIFY_WEBHOOK_SECRET=

# Bark 推送：收到新留言或打赏时推送到 iPhone（可选，留空则不推送）
# 在 Bark App 中复制的设备 key
BARK_DEVICE_KEY=
# 自建 Bark 服务端地址，留空使用官方 https://api.day.app
BARK_SERVER_URL=

# 打赏支付：微信 + 支付宝（密钥只放服务端，切勿提交真实值）
# 微信支付 APIv3
WECHAT_MCH_ID=
WECHAT_APP_ID=
# 32 位 APIv3 密钥
WECHAT_API_V3_KEY=
# 商户 API 证书序列号
WECHAT_CERT_SERIAL_NO=
# apiclient_key.pem 内容，换行可写成 \n
WECHAT_PRIVATE_KEY=
# 微信支付公钥模式：公钥 ID 与公钥内容（用于回调验签）
WECHAT_PUBLIC_KEY_ID=
WECHAT_PUBLIC_KEY=
# 公众号 AppSecret，用于微信内网页授权与 JSAPI 支付
WECHAT_APP_SECRET=
# 可选：自定义回调地址，默认按 SITE_URL 拼接
WECHAT_NOTIFY_URL=
# 支付宝开放平台（RSA2）
ALIPAY_APP_ID=
# 应用私钥，换行可写成 \n
ALIPAY_PRIVATE_KEY=
# 支付宝公钥，用于回调验签
ALIPAY_PUBLIC_KEY=
# 可选：网关与回调地址
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_NOTIFY_URL=
# 无状态订单签名密钥（可选）：随机 32 位以上字符串，用于签发和校验查单令牌
# 留空时自动从支付私钥（WECHAT_PRIVATE_KEY 或 ALIPAY_PRIVATE_KEY）派生，无需手动生成
DONATION_ORDER_SECRET=

# 站点备案信息（可选）。NEXT_PUBLIC_* 会在构建时内联，修改后需重新部署。
# 不配置时使用 src/lib/site.ts 中的默认值；显式留空可隐藏页脚备案信息。
# NEXT_PUBLIC_ICP_NUMBER=晋ICP备2026019630号
# NEXT_PUBLIC_ICP_LINK=https://beian.miit.gov.cn/

# 本地/预览环境的 dev 来源白名单（可选，逗号分隔），供 next.config.ts 的 allowedDevOrigins 使用
# NEXT_ALLOWED_DEV_ORIGINS=
