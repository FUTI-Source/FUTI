{
  "name": "personal-site-nextjs",
  "version": "1.0.0",
  "private": true,
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": [
    "chrome >= 125",
    "edge >= 125",
    "firefox >= 126",
    "safari >= 17.5",
    "ios >= 17.5",
    "and_chr >= 125"
  ],
  "overrides": {
    "postcss": "$postcss"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build/bump-sw-version.mjs",
    "sw:version": "node scripts/build/bump-sw-version.mjs",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node scripts/build/prepare-standalone.mjs && node .next/standalone/server.js",
    "type:check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@pixi/app": "6.5.10",
    "@pixi/core": "6.5.10",
    "@pixi/display": "6.5.10",
    "@pixi/interaction": "6.5.10",
    "@pixi/math": "6.5.10",
    "@pixi/ticker": "6.5.10",
    "@pixi/utils": "6.5.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "normalize.css": "^8.0.1",
    "parallax-js": "^3.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.65.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5.9.2"
  }
